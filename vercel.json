    },
    {
      "source": "/author/:path*",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/:name(page|post|category|author)-sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }

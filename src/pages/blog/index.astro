---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Migalhas from '../../components/Migalhas.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts } from '../../data/posts';
const mig = [{ nome: 'Blog', href: '/blog' }];
---
<Base title="Blog: dúvidas sobre consultas e exames em Bom Jesus-PI | Clínica Dr. Ricardo Xavier" description="Respostas curtas sobre ressonância, jejum para exame de sangue, pré-natal, pressão alta e mais. Blog da Clínica Dr. Ricardo Xavier, Bom Jesus-PI." migalhas={mig}>
  <section class="sec bg-creme" style="padding-top:32px">
    <div class="wrap">
      <Migalhas itens={mig} />
      <p class="eyebrow">Blog</p>
      <h1>Dúvidas que chegam na recepção</h1>
      <p class="lead">Respostas curtas sobre exames e consultas em Bom Jesus. Conteúdo informativo, não substitui consulta.</p>
      <div class="grid g3" style="margin-top:40px;gap:20px">
        {posts.map((p) => (
          <a class="card" href={`/blog/${p.slug}`} style="padding:32px"><span class="tag" style="align-self:flex-start">{p.categoria}</span><h2 style="font-size:21px;line-height:1.3;margin:0">{p.titulo}</h2><span class="small muted">{p.descricao}</span><span style="color:var(--vermelho);font-weight:700;display:flex;gap:8px;align-items:center">Ler <Icon name="seta" size={18} /></span></a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand msg="Olá! Vim pelo blog e quero agendar um atendimento." origem="blog" />
</Base>
